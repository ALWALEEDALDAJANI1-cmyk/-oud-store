========================================= */

function openProduct(id){

selectedProduct=products.find(p=>p.id===id);

if(!selectedProduct)return;

document.getElementById("modalArt").innerHTML=
productArt(selectedProduct.type);

document.getElementById("modalOrigin").textContent=
selectedProduct.origin;

document.getElementById("modalName").textContent=
selectedProduct.name;

document.getElementById("modalDescription").textContent=
selectedProduct.description;

document.getElementById("modalUse").textContent=
selectedProduct.use;

document.getElementById("modalFrom").textContent=
selectedProduct.from;

document.getElementById("modalWeightText").textContent=
selectedProduct.weight;

document.getElementById("modalPrice").textContent=
selectedProduct.price+" ر.س";

document.getElementById("modalWeight").innerHTML=`
<option>${selectedProduct.weight}</option>
`;

document.getElementById("productModal")
.classList.add("show");

}


function closeProduct(){

document.getElementById("productModal")
.classList.remove("show");

selectedProduct=null;

}


function addModalProduct(){

if(selectedProduct){

addToCart(selectedProduct.id);

closeProduct();

openCart();

}

}


/* =========================================
   ADD CART
========================================= */

function addToCart(id){

const p=products.find(x=>x.id===id);

if(!p)return;

const found=cart.find(x=>x.id===id);

if(found){

found.qty++;

}else{

cart.push({
...p,
qty:1
});

}

save();
renderCart();

toast("تمت إضافة "+p.name+" إلى السلة 🤍");

}


function changeQuantity(id,n){

const item=cart.find(x=>x.id===id);

if(!item)return;

item.qty+=n;

if(item.qty<=0){

cart=cart.filter(x=>x.id!==id);

}

save();
renderCart();

}


/* =========================================
   RENDER CART
========================================= */

function renderCart(){

const items=document.getElementById("cartItems");

const count=cart.reduce(
(s,x)=>s+x.qty,0
);

const total=cart.reduce(
(s,x)=>s+(x.price*x.qty),0
);

document.getElementById("cartCount")
.textContent=count;

document.getElementById("total")
.textContent=total+" ر.س";

if(cart.length===0){

items.innerHTML=`
<div class="empty">
السلة فارغة 🤍
<br>
اختر من مختارات ترف العود.
</div>
`;

return;

}

items.innerHTML=cart.map(item=>`

<div class="cart-item">

<div class="cart-item-art">
${productArt(item.type)}
</div>

<div class="cart-info">

<h4>${item.name}</h4>

<small>
${item.weight} • ${item.price} ر.س
</small>

<div class="quantity">

<button onclick="changeQuantity('${item.id}',-1)">
−
</button>

<strong>
${item.qty}
</strong>

<button onclick="changeQuantity('${item.id}',1)">
+
</button>

</div>

</div>

<strong>
${item.price*item.qty} ر.س
</strong>

</div>

`).join("");

}


/* =========================================
   CART OPEN
========================================= */

function openCart(){

document.getElementById("cart")
.classList.add("open");

document.getElementById("overlay")
.classList.add("show");

}


function closeCart(){

document.getElementById("cart")
.classList.remove("open");

document.getElementById("overlay")
.classList.remove("show");

}


/* =========================================
   CHECKOUT
========================================= */

function checkout(){

if(cart.length===0){

alert("السلة فارغة.");

return;

}

closeCart();

const total=cart.reduce(
(s,x)=>s+(x.price*x.qty),0
);

document.getElementById("summary").innerHTML=`

${cart.map(x=>`

<div style="
display:flex;
justify-content:space-between;
margin-bottom:8px;
">

<span>
${x.name} × ${x.qty}
</span>

<strong>
${x.price*x.qty} ر.س
</strong>

</div>

`).join("")}

<hr style="
border:0;
border-top:1px solid var(--border);
margin:13px 0;
">

<div style="
display:flex;
justify-content:space-between;
font-size:20px;
font-weight:900;
">

<span>الإجمالي</span>
<span>${total} ر.س</span>

</div>
`;

document.getElementById("checkoutModal")
.classList.add("show");

}


function closeCheckout(){

document.getElementById("checkoutModal")
.classList.remove("show");

}


/* =========================================
   WHATSAPP
========================================= */

function sendWhatsApp(){

const name=document
.getElementById("customerName")
.value.trim();

const location=document
.getElementById("customerLocation")
.value.trim();

const note=document
.getElementById("customerNote")
.value.trim();

if(!name){

alert("اكتب اسمك.");

return;

}

if(!location){

alert("اكتب المدينة والحي.");

return;

}

const total=cart.reduce(
(s,x)=>s+(x.price*x.qty),0
);

let message=
"السلام عليكم ورحمة الله وبركاته 🤍\n\n"+
"أرغب بالطلب من متجر ترف العود:\n\n";

cart.forEach((x,i)=>{

message+=
`${i+1}. ${x.name}
الوزن: ${x.weight}
الكمية: ${x.qty}
السعر: ${x.price*x.qty} ر.س

`;

});

message+=
`الإجمالي: ${total} ر.س

الاسم: ${name}
المدينة والحي: ${location}`;

if(note){

message+=
`\n\nملاحظة:
${note}`;

}

message+=
`\n\nلأن العود ترف.
ترف العود 🤍`;

window.open(
"https://wa.me/"+
WHATSAPP_NUMBER+
"?text="+
encodeURIComponent(message),
"_blank"
);

}


