<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>ترف العود | لأن العود ترف</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Playfair+Display:wght@600;700&display=swap');

:root{
  --cream:#f3ede3;
  --cream2:#e8dfd2;
  --paper:#fbf7f0;
  --brown:#4a3428;
  --brown2:#6d4c38;
  --gold:#b39158;
  --gold2:#d4bd91;
  --red:#641d24;
  --red2:#812b32;
  --text:#302821;
  --muted:#776b60;
  --border:#ded1c0;
  --shadow:0 22px 60px rgba(66,43,27,.14);
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Cairo,sans-serif;
  background:
    radial-gradient(circle at 10% 10%,rgba(179,145,88,.08),transparent 25%),
    var(--cream);
  color:var(--text);
  line-height:1.8;
}

button,input,textarea,select{
  font-family:inherit;
}

button{
  cursor:pointer;
}

a{
  text-decoration:none;
  color:inherit;
}

/* =========================
   TOP
========================= */

.top{
  background:var(--brown);
  color:#f6ead9;
  text-align:center;
  padding:7px 15px;
  font-size:12px;
}

/* =========================
   NAV
========================= */

nav{
  height:78px;
  position:sticky;
  top:0;
  z-index:100;
  background:rgba(243,237,227,.94);
  backdrop-filter:blur(18px);
  border-bottom:1px solid rgba(74,52,40,.12);
}

.nav{
  max-width:1280px;
  height:100%;
  padding:0 22px;
  margin:auto;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.brand{
  display:flex;
  align-items:center;
  gap:11px;
}

.brand-icon{
  width:46px;
  height:46px;
  border-radius:50%;
  background:var(--red);
  color:#ead39e;
  display:grid;
  place-items:center;
  font-family:Georgia,serif;
  font-size:22px;
  box-shadow:0 8px 22px rgba(100,29,36,.25);
}

.brand-name{
  color:var(--brown);
  font-size:20px;
  font-weight:900;
}

.brand-sub{
  display:block;
  color:var(--muted);
  font-size:9px;
  line-height:1;
}

.links{
  display:flex;
  gap:28px;
  color:var(--brown);
  font-size:14px;
  font-weight:600;
}

.links a:hover{
  color:var(--red);
}

.cart-button{
  border:0;
  background:var(--red);
  color:#fff;
  padding:10px 17px;
  border-radius:30px;
  font-weight:800;
  display:flex;
  gap:8px;
  align-items:center;
}

.cart-number{
  width:23px;
  height:23px;
  background:#ecd19b;
  color:var(--red);
  border-radius:50%;
  display:grid;
  place-items:center;
  font-size:11px;
}

/* =========================
   HERO
========================= */

.hero{
  min-height:700px;
  position:relative;
  overflow:hidden;
  display:flex;
  align-items:center;
  background:
    linear-gradient(110deg,#806a52 0%,#5a4434 48%,#32251e 100%);
}

.hero-art{
  position:absolute;
  inset:0;
  opacity:.75;
}

.hero-art svg{
  width:100%;
  height:100%;
}

.hero::after{
  content:"";
  position:absolute;
  inset:0;
  background:
    linear-gradient(90deg,rgba(40,28,20,.08),rgba(40,28,20,.62));
}

.hero-content{
  position:relative;
  z-index:2;
  max-width:1280px;
  width:100%;
  margin:auto;
  padding:90px 22px;
  color:white;
}

.hero-copy{
  max-width:650px;
}

.kicker{
  color:#e3c88f;
  font-size:13px;
  font-weight:800;
  letter-spacing:2px;
}

.hero h1{
  font-size:clamp(55px,9vw,105px);
  line-height:.95;
  margin-top:12px;
  font-weight:900;
}

.hero h1 span{
  color:#e2c38b;
}

.hero-title{
  font-family:"Playfair Display",Georgia,serif;
  font-size:clamp(42px,6vw,75px);
  color:#f5e8d1;
  margin-top:5px;
}

.hero p{
  font-size:17px;
  color:#f5eadd;
  margin:25px 0 30px;
}

.actions{
  display:flex;
  flex-wrap:wrap;
  gap:12px;
}

.btn{
  border:0;
  padding:13px 24px;
  border-radius:30px;
  font-weight:800;
  transition:.25s;
}

.btn:hover{
  transform:translateY(-3px);
}

.primary{
  background:#e8c88e;
  color:#4c3425;
}

.secondary{
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.4);
  color:white;
}

/* =========================
   SECTION
========================= */

.section{
  max-width:1280px;
  margin:95px auto;
  padding:0 22px;
}

.section-head{
  display:flex;
  justify-content:space-between;
  align-items:end;
  gap:25px;
  margin-bottom:35px;
}

.section-title{
  font-size:43px;
  color:var(--brown);
  line-height:1.2;
  margin-top:5px;
}

.section-description{
  max-width:530px;
  color:var(--muted);
}

/* =========================
   OIL MABKHARA
========================= */

.mabkhara{
  min-height:550px;
  position:relative;
  overflow:hidden;
  border-radius:38px;
  background:
    linear-gradient(115deg,#351b18,#6b2228 45%,#301719);
  box-shadow:var(--shadow);
}

.mabkhara svg{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
}

.mabkhara-content{
  position:relative;
  z-index:3;
  padding:70px;
  max-width:610px;
  color:white;
}

.mabkhara-content h2{
  font-size:48px;
  line-height:1.2;
  margin:10px 0 20px;
}

.mabkhara-content p{
  color:#f1ded5;
  font-size:16px;
}

.line{
  width:70px;
  height:4px;
  background:#c04c50;
  border-radius:10px;
  margin:20px 0;
}

/* =========================
   PRODUCTS
========================= */

.products{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:22px;
}

.product{
  background:var(--paper);
  border:1px solid var(--border);
  border-radius:25px;
  overflow:hidden;
  box-shadow:0 8px 25px rgba(61,43,29,.06);
  transition:.3s;
}

.product:hover{
  transform:translateY(-7px);
  box-shadow:var(--shadow);
}

.product-picture{
  height:270px;
  position:relative;
  cursor:pointer;
  overflow:hidden;
  background:linear-gradient(135deg,#684a37,#2e211a);
}

.product-picture svg{
  width:100%;
  height:100%;
}

.badge{
  position:absolute;
  top:14px;
  right:14px;
  background:var(--red);
  color:#fff;
  padding:5px 11px;
  border-radius:20px;
  font-size:10px;
  font-weight:800;
}

.product-body{
  padding:20px;
}

.origin{
  color:var(--gold);
  font-size:11px;
  font-weight:900;
}

.product h3{
  color:var(--brown);
  font-size:21px;
  margin:3px 0 5px;
}

.use{
  color:var(--muted);
  font-size:13px;
  min-height:49px;
}

.product-bottom{
  margin-top:17px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.price{
  color:var(--red);
  font-weight:900;
  font-size:20px;
}

.price small{
  color:var(--muted);
  font-size:10px;
}

.add{
  background:var(--brown);
  color:white;
  border:0;
  border-radius:12px;
  padding:10px 13px;
  font-size:12px;
  font-weight:800;
}

.add:hover{
  background:var(--red);
}

/* =========================
   FARM ART
========================= */

.farm{
  min-height:590px;
  border-radius:38px;
  overflow:hidden;
  position:relative;
  background:#6b7751;
  box-shadow:var(--shadow);
}

.farm svg{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
}

.farm-text{
  position:relative;
  z-index:3;
  max-width:610px;
  padding:75px;
  color:white;
}

.farm-text h2{
  font-size:47px;
  line-height:1.25;
  margin:10px 0 18px;
}

.farm-text p{
  color:#f1eadb;
}

/* =========================
   USE CARDS
========================= */

.use-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:18px;
}

.use-card{
  background:rgba(255,255,255,.46);
  border:1px solid var(--border);
  padding:27px;
  border-radius:23px;
}

.number{
  color:var(--gold);
  font-family:Georgia,serif;
  font-size:38px;
}

.use-card h3{
  color:var(--brown);
  margin:5px 0;
}

.use-card p{
  color:var(--muted);
  font-size:13px;
}

/* =========================
   ABOUT
========================= */

.about{
  border-radius:38px;
  background:var(--brown);
  color:white;
  padding:70px;
  position:relative;
  overflow:hidden;
}

.about::after{
  content:"ترف";
  position:absolute;
  left:-10px;
  bottom:-90px;
  font-family:Georgia,serif;
  font-size:220px;
  color:rgba(255,255,255,.035);
}

.about h2{
  font-size:45px;
}

.about p{
  max-width:850px;
  color:#e6d9ca;
}

/* =========================
   MODALS
========================= */

.modal{
  position:fixed;
  inset:0;
  z-index:500;
  background:rgba(25,17,12,.73);
  backdrop-filter:blur(10px);
  display:none;
  align-items:center;
  justify-content:center;
  padding:18px;
}

.modal.show{
  display:flex;
}

.modal-box{
  width:min(900px,100%);
  max-height:93vh;
  overflow:auto;
  border-radius:30px;
  background:var(--paper);
  position:relative;
  box-shadow:0 30px 90px rgba(0,0,0,.3);
}

.close{
  position:absolute;
  left:15px;
  top:15px;
  width:40px;
  height:40px;
  border:0;
  background:rgba(255,255,255,.9);
  border-radius:50%;
  font-size:22px;
  z-index:10;
  color:var(--brown);
}

.product-modal{
  display:grid;
  grid-template-columns:1fr 1fr;
}

.modal-image{
  min-height:520px;
  background:#614633;
}

.modal-image svg{
  width:100%;
  height:100%;
}

.modal-details{
  padding:45px;
}

.modal-details h2{
  color:var(--brown);
  font-size:38px;
  line-height:1.2;
}

.modal-details p{
  color:var(--muted);
  margin:15px 0;
}

.detail{
  border-top:1px solid var(--border);
  display:flex;
  justify-content:space-between;
  padding:12px 0;
  font-size:13px;
}

.detail strong{
  color:var(--brown);
}

.weight{
  margin:20px 0;
  padding:15px;
  background:var(--cream2);
  border-radius:15px;
}

.weight label{
  display:block;
  font-weight:800;
  font-size:12px;
}

.weight select{
  width:100%;
  border:1px solid var(--border);
  background:white;
  padding:11px;
  border-radius:10px;
  margin-top:6px;
}

.modal-add{
  width:100%;
  border:0;
  background:var(--red);
  color:white;
  padding:15px;
  border-radius:14px;
  font-weight:900;
}

/* =========================
   CART
========================= */

.overlay{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.28);
  z-index:300;
  display:none;
}

.overlay.show{
  display:block;
}

.cart{
  position:fixed;
  z-index:400;
  top:0;
  left:-450px;
  width:min(440px,95vw);
  height:100vh;
  background:var(--paper);
  box-shadow:20px 0 70px rgba(0,0,0,.2);
  transition:.35s;
  display:flex;
  flex-direction:column;
}

.cart.open{
  left:0;
}

.cart-head{
  padding:21px;
  border-bottom:1px solid var(--border);
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.cart-head h2{
  color:var(--brown);
}

.cart-items{
  flex:1;
  overflow:auto;
  padding:18px;
}

.empty{
  text-align:center;
  color:var(--muted);
  padding:80px 20px;
}

.cart-item{
  display:flex;
  gap:12px;
  padding:14px 0;
  border-bottom:1px solid var(--border);
}

.cart-item-art{
  width:70px;
  height:70px;
  border-radius:13px;
  overflow:hidden;
  flex:none;
}

.cart-item-art svg{
  width:100%;
  height:100%;
}

.cart-info{
  flex:1;
}

.cart-info h4{
  color:var(--brown);
}

.cart-info small{
  color:var(--muted);
}

.quantity{
  display:flex;
  align-items:center;
  gap:7px;
  margin-top:6px;
}

.quantity button{
  width:26px;
  height:26px;
  border:1px solid var(--border);
  background:white;
  border-radius:7px;
}

.cart-footer{
  padding:20px;
  border-top:1px solid var(--border);
}

.total{
  display:flex;
  justify-content:space-between;
  font-size:20px;
  font-weight:900;
  margin-bottom:13px;
}

.checkout{
  width:100%;
  border:0;
  background:var(--red);
  color:white;
  padding:15px;
  border-radius:14px;
  font-weight:900;
}

/* =========================
   CHECKOUT
========================= */

.checkout-content{
  padding:40px;
}

.checkout-content h2{
  color:var(--brown);
  font-size:34px;
}

.summary{
  background:var(--cream2);
  border-radius:15px;
  padding:18px;
  margin:18px 0;
}

.field{
  margin-bottom:13px;
}

.field label{
  display:block;
  font-size:12px;
  font-weight:900;
  margin-bottom:5px;
}

.field input,
.field textarea{
  width:100%;
  padding:12px;
  border:1px solid var(--border);
  border-radius:11px;
  background:white;
  outline:0;
}

.field textarea{
  min-height:90px;
}

.whatsapp{
  width:100%;
  border:0;
  background:#238947;
  color:white;
  padding:15px;
  border-radius:14px;
  font-weight:900;
}

/* =========================
   FOOTER
========================= */

footer{
  background:#3a2a21;
  color:white;
  text-align:center;
  padding:50px 20px;
}

footer h2{
  color:#e3c68e;
}

/* =========================
   MOBILE
========================= */

@media(max-width:1050px){

  .products,
  .use-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .links{
    display:none;
  }

  .product-modal{
    grid-template-columns:1fr;
  }

  .modal-image{
    min-height:330px;
    height:330px;
  }
}

@media(max-width:650px){

  nav{
    height:68px;
  }

  .brand-name{
    font-size:17px;
  }

  .hero{
    min-height:650px;
  }

  .hero h1{
    font-size:60px;
  }

  .hero-title{
    font-size:44px;
  }

  .products,
  .use-grid{
    grid-template-columns:1fr;
  }

  .section-head{
    display:block;
  }

  .section-title{
    font-size:34px;
  }

  .mabkhara-content,
  .farm-text,
  .about{
    padding:38px 25px;
  }

  .mabkhara-content h2,
  .farm-text h2,
  .about h2{
    font-size:35px;
  }

  .modal-details{
    padding:28px;
  }
}
</style>
</head>

<body>

<div class="top">
  ✦ ترف العود — لأن العود ترف ✦
</div>

<nav>
  <div class="nav">

    <a class="brand" href="#home">
      <div class="brand-icon">ت</div>

      <div>
        <div class="brand-name">ترف العود</div>
        <span class="brand-sub">لأن العود ترف</span>
      </div>
    </a>

    <div class="links">
      <a href="#home">الرئيسية</a>
      <a href="#products">المتجر</a>
      <a href="#story">حكاية العود</a>
      <a href="#about">عن ترف العود</a>
    </div>

    <button class="cart-button" onclick="openCart()">
      🛒 السلة
      <span class="cart-number" id="cartCount">0</span>
    </button>

  </div>
</nav>


<!-- =========================
     HERO ART
========================= -->

<section class="hero" id="home">

<div class="hero-art">

<svg viewBox="0 0 1600 800" preserveAspectRatio="xMidYMid slice">

<defs>

<linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
  <stop offset="0" stop-color="#8c765c"/>
  <stop offset=".55" stop-color="#69533f"/>
  <stop offset="1" stop-color="#33261e"/>
</linearGradient>

<linearGradient id="ground" x1="0" y1="0" x2="1" y2="0">
  <stop offset="0" stop-color="#5d4937"/>
  <stop offset=".5" stop-color="#403126"/>
  <stop offset="1" stop-color="#261d18"/>
</linearGradient>

<filter id="soft">
  <feGaussianBlur stdDeviation="9"/>
</filter>

</defs>

<rect width="1600" height="800" fill="url(#sky)"/>

<!-- painted clouds -->

