L760 330 L920 470 L1090 370 L1280 490
L1440 360 L1600 460 L1600 800 L0 800Z"
fill="#47372b" opacity=".9"/>

<!-- trees -->

<g fill="#27382a">

<path d="M190 520
C160 460 170 390 205 340
