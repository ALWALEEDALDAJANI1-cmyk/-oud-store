C270 420 310 425 315 390
C330 470 295 515 260 535Z"/>

<path d="M420 550
C390 470 405 400 440 350
C445 405 480 425 470 485
C510 430 550 450 555 405
C565 490 530 535 490 560Z"/>

<path d="M1250 540
C1210 450 1230 370 1265 330
C1260 410 1305 425 1290 490
C1330 430 1375 450 1380 395
C1390 490 1345 530 1300 555Z"/>

</g>

<!-- farmers -->

<g fill="#241d18">

<circle cx="720" cy="485" r="25"/>
<path d="M685 520 Q720 495 755 520 L770 660 L670 660Z"/>

<circle cx="830" cy="500" r="23"/>
<path d="M795 530 Q830 505 865 530 L875 660 L785 660Z"/>

</g>

<!-- wood piles -->

<g fill="#9a6c42">

<ellipse cx="620" cy="650" rx="95" ry="30"/>
<ellipse cx="760" cy="670" rx="100" ry="31"/>
<ellipse cx="900" cy="650" rx="90" ry="28"/>

</g>

<rect y="650" width="1600" height="150" fill="url(#ground)"/>

</svg>

</div>


<div class="hero-content">

  <div class="hero-copy">

    <div class="kicker">
      T A R A F&nbsp; A L&nbsp; O U D
    </div>

    <h1>
      لأن العود
    </h1>

    <div class="hero-title">
      ترف.
    </div>

    <p>
      يامرحبا ترحيبة كلها أطياب<br>
      أحلى من العنبر وأزكى من العود 🤍
    </p>

    <div class="actions">

      <a class="btn primary" href="#products">
        اكتشف المختارات
      </a>

      <a class="btn secondary" href="#story">
        حكاية العود
      </a>

    </div>

  </div>

</div>

</section>


<!-- =========================
     MABKHARA
========================= -->

<section class="section">

<div class="mabkhara">

<svg viewBox="0 0 1300 550" preserveAspectRatio="xMidYMid slice">

<defs>

<linearGradient id="redBg" x1="0" y1="0" x2="1" y2="1">
  <stop offset="0" stop-color="#311719"/>
  <stop offset=".5" stop-color="#71272c"/>
  <stop offset="1" stop-color="#241214"/>
</linearGradient>

<radialGradient id="ember">
  <stop offset="0" stop-color="#ffd36b"/>
  <stop offset=".35" stop-color="#d95728"/>
  <stop offset="1" stop-color="#641d20"/>
</radialGradient>

<filter id="smokeBlur">
  <feGaussianBlur stdDeviation="15"/>
</filter>

</defs>

<rect width="1300" height="550" fill="url(#redBg)"/>

<!-- decorative oil strokes -->

<path d="M0 90 C230 10 390 150 610 80
C850 5 1060 130 1300 45"
fill="none"
stroke="#9e4045"
stroke-width="30"
opacity=".22"/>

<path d="M0 500 C250 430 430 550 690 460
C940 370 1100 510 1300 410"
fill="none"
stroke="#d07b67"
stroke-width="20"
opacity=".12"/>

<!-- smoke -->

<g fill="#eadbd0" opacity=".17" filter="url(#smokeBlur)">

<path d="M790 330
C700 240 850 210 780 120
C730 50 850 30 870 0
C970 90 860 170 930 230
C1000 300 900 360 790 330Z"/>

<path d="M920 310
C870 230 1000 200 955 130
C920 70 1020 45 1035 5
C1110 100 1010 180 1080 230
